@* Numeric measurement field: minus/plus steppers plus direct manual entry.
   Stores inches; displays/edits in the user's chosen unit. *@
@using System.Globalization
@inject ILocalizationService Loc
@inject IAppSettingsService Settings

<div class="app-card p-3">
    <p class="truncate text-sm font-medium text-subtle">@Label</p>
    <div class="mt-2 flex items-center gap-1">
        <button type="button" @onclick="Dec" aria-label="−"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-cream-line text-ink active:scale-95">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
                 stroke-linecap="round"><path d="M5 12h14" /></svg>
        </button>

        <div class="flex flex-1 items-baseline justify-center gap-1">
            <input @key="_rev" type="text" inputmode="decimal" value="@DisplayText"
                   @onchange="OnManualInput"
                   class="w-14 min-w-0 bg-transparent text-center text-2xl font-bold text-ink focus:outline-none" />
            <span class="shrink-0 text-xs text-subtle">@UnitLabel</span>
        </div>

        <button type="button" @onclick="Inc" aria-label="+"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-cream-line text-ink active:scale-95">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
                 stroke-linecap="round"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public double? Value { get; set; }
    [Parameter] public EventCallback<double?> ValueChanged { get; set; }
    [Parameter] public double Step { get; set; } = 0.5;
    [Parameter] public double Min { get; set; } = 0;
    [Parameter] public double Max { get; set; } = 120;

    private int _rev;

    private MeasurementUnit Unit => Settings.Unit;
    private string UnitLabel => Unit == MeasurementUnit.Centimeters ? Loc["Form.UnitCm"] : Loc["Form.Unit"];

    private double CurrentInches => Value ?? 0;
    private double DisplayValue => DisplayFormat.ToDisplayUnit(CurrentInches, Unit);
    private string DisplayText => DisplayFormat.Measurement(CurrentInches, Unit);

    private Task Inc() => CommitDisplay(DisplayValue + Step);
    private Task Dec() => CommitDisplay(DisplayValue - Step);

    private Task OnManualInput(ChangeEventArgs e)
    {
        _rev++;
        return TryParse(e.Value?.ToString(), out var entered)
            ? CommitDisplay(entered)
            : Commit(CurrentInches);
    }

    private Task CommitDisplay(double displayValue)
    {
        var min = DisplayFormat.ToDisplayUnit(Min, Unit);
        var max = DisplayFormat.ToDisplayUnit(Max, Unit);
        var clamped = Math.Clamp(displayValue, min, max);
        return Commit(DisplayFormat.ToInches(clamped, Unit));
    }

    private Task Commit(double inches) => ValueChanged.InvokeAsync(Math.Round(inches, 2));

    private static bool TryParse(string? text, out double value)
    {
        if (!string.IsNullOrWhiteSpace(text) &&
            (double.TryParse(text, NumberStyles.Any, CultureInfo.InvariantCulture, out value) ||
             double.TryParse(text, NumberStyles.Any, CultureInfo.CurrentCulture, out value)))
        {
            return true;
        }
        value = 0;
        return false;
    }
}
