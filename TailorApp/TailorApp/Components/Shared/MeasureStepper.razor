@* Numeric measurement field with minus/plus steppers (inches). *@
@inject ILocalizationService Loc

<div class="app-card p-3">
    <p class="truncate text-sm font-medium text-subtle">@Label</p>
    <div class="mt-2 flex items-center justify-between gap-1">
        <button type="button" @onclick="Dec" aria-label="−"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-cream-line text-ink active:scale-95">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
                 stroke-linecap="round"><path d="M5 12h14" /></svg>
        </button>
        <span class="flex items-baseline gap-1">
            <span class="text-2xl font-bold text-ink">@DisplayFormat.Number(Current)</span>
            <span class="text-xs text-subtle">@Loc["Form.Unit"]</span>
        </span>
        <button type="button" @onclick="Inc" aria-label="+"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-cream-line text-ink active:scale-95">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
                 stroke-linecap="round"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public double? Value { get; set; }
    [Parameter] public EventCallback<double?> ValueChanged { get; set; }
    [Parameter] public double Step { get; set; } = 0.5;
    [Parameter] public double Min { get; set; } = 0;
    [Parameter] public double Max { get; set; } = 120;

    private double Current => Value ?? 0;

    private Task Inc() => Commit(Math.Min(Max, Current + Step));
    private Task Dec() => Commit(Math.Max(Min, Current - Step));
    private Task Commit(double value) => ValueChanged.InvokeAsync(Math.Round(value, 2));
}
