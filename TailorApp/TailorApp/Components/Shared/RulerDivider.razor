@* Decorative measuring-tape divider used beside section titles. *@
<div class="ms-3 flex-1 overflow-hidden opacity-80">
    <svg class="h-5 w-full" preserveAspectRatio="none" viewBox="0 0 200 20" aria-hidden="true">
        @for (var i = 0; i <= 40; i++)
        {
            var x = i * 5;
            var major = i % 5 == 0;
            var accent = i == 27 || i == 34;
            <line x1="@x" y1="@(major ? 1 : 6)" x2="@x" y2="15"
                  stroke="@(accent ? "#9E3328" : "#CBBEA8")" stroke-width="1" />
        }
    </svg>
</div>
