@page "/customers/new"
@page "/customers/{Id}/edit"
@implements IDisposable
@inject ICustomerService CustomerService
@inject IMeasurementService MeasurementService
@inject ILocalizationService Loc
@inject IAppSettingsService Settings
@inject NavigationManager Nav

<EditForm Model="_customer" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />

    <!-- Header -->
    <header class="flex items-center gap-2 pt-2">
        <button type="button" @onclick="GoBack" aria-label="@Loc["Common.Cancel"]"
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-ink">
            <svg class="h-6 w-6 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round"><path d="m15 6-6 6 6 6" /></svg>
        </button>
        <h1 class="flex-1 font-serif text-2xl font-bold text-ink">
            @(_isEdit ? Loc["Customer.Edit"] : Loc["Customer.Add"])
        </h1>
        <button type="submit" disabled="@_saving" class="shrink-0 px-2 text-base font-semibold text-brick disabled:opacity-50">
            @Loc["Common.Save"]
        </button>
    </header>

    @if (_loading)
    {
        <div class="mt-16 text-center text-subtle">@Loc["Common.Loading"]</div>
    }
    else if (_notFound)
    {
        <div class="app-card mt-6 px-4 py-8 text-center text-sm text-subtle">@Loc["Common.NoResults"]</div>
    }
    else
    {
        <!-- ===== Customer information ===== -->
        <SectionHeading Title="@Loc["Form.CustomerInfo"]" />

        <div class="mt-3 space-y-4">
            <div>
                <label class="mb-1.5 block text-sm font-medium text-ink">@Loc["Form.CustomerName"]</label>
                <div class="relative">
                    <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-4 text-ink">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                            <circle cx="12" cy="8" r="3.6" /><path d="M4.5 19.5a7.5 7.5 0 0 1 15 0Z" />
                        </svg>
                    </span>
                    <InputText @bind-Value="_customer.Name" autocomplete="off"
                               placeholder="@Loc["Form.NamePlaceholder"]" class="app-input ps-11" />
                </div>
                <ValidationMessage For="() => _customer.Name" class="mt-1 block text-xs text-brick" />
            </div>

            <div>
                <label class="mb-1.5 block text-sm font-medium text-ink">@Loc["Customer.Phone"]</label>
                <div class="relative">
                    <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-4 text-ink">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.2 2.2Z" />
                        </svg>
                    </span>
                    <InputText @bind-Value="_customer.PhoneNumber" type="tel" autocomplete="off"
                               placeholder="@Loc["Form.PhonePlaceholder"]" class="app-input ps-11" />
                </div>
                <ValidationMessage For="() => _customer.PhoneNumber" class="mt-1 block text-xs text-brick" />
            </div>

            <div>
                <label class="mb-1.5 block text-sm font-medium text-ink">
                    @Loc["Customer.Address"]<span class="font-normal text-subtle"> · @Loc["Form.Optional"]</span>
                </label>
                <InputText @bind-Value="_customer.Address" autocomplete="off"
                           placeholder="@Loc["Form.AddressPlaceholder"]" class="app-input" />
                <ValidationMessage For="() => _customer.Address" class="mt-1 block text-xs text-brick" />
            </div>

            <div>
                <label class="mb-1.5 block text-sm font-medium text-ink">
                    @Loc["Customer.Notes"]<span class="font-normal text-subtle"> · @Loc["Form.Optional"]</span>
                </label>
                <InputTextArea @bind-Value="_customer.Notes" rows="3"
                               placeholder="@Loc["Form.NotesPlaceholder"]" class="app-input" />
                <ValidationMessage For="() => _customer.Notes" class="mt-1 block text-xs text-brick" />
            </div>
        </div>

        <!-- ===== Kameez ===== -->
        <SectionHeading Title="@($"{Loc["Measurement.Kameez"]} · {Loc["Form.Inches"]}")" />

        <div class="mt-3 grid grid-cols-2 gap-3">
            <MeasureStepper Label="@Loc["Measurement.Length"]" @bind-Value="_m.KameezLength" />
            <MeasureStepper Label="@Loc["Measurement.Chest"]" @bind-Value="_m.Chest" />
            <MeasureStepper Label="@Loc["Measurement.Waist"]" @bind-Value="_m.Waist" />
            <MeasureStepper Label="@Loc["Measurement.Shoulder"]" @bind-Value="_m.Shoulder" />
            <MeasureStepper Label="@Loc["Measurement.SleeveLength"]" @bind-Value="_m.SleeveLength" />
            <MeasureStepper Label="@Loc["Form.CollarSize"]" @bind-Value="_m.Collar" />
        </div>

        <div class="mt-3 space-y-3">
            <ToggleRow Label="@Loc["Form.FrontPocket"]" Optional="true" @bind-Value="_m.FrontPocket" />
            <ToggleRow Label="@Loc["Form.SidePocket"]" Optional="true" @bind-Value="_m.SidePocket" />
        </div>

        <!-- ===== Shalwar ===== -->
        <SectionHeading Title="@($"{Loc["Measurement.Shalwar"]} · {Loc["Form.Inches"]}")" />

        <div class="mt-3 grid grid-cols-2 gap-3">
            <MeasureStepper Label="@Loc["Measurement.Length"]" @bind-Value="_m.ShalwarLength" />
            <MeasureStepper Label="@Loc["Measurement.Waist"]" @bind-Value="_m.ShalwarWaist" />
            <MeasureStepper Label="@Loc["Measurement.Hip"]" @bind-Value="_m.Hip" />
            <MeasureStepper Label="@Loc["Form.ThighWidth"]" @bind-Value="_m.ThighWidth" />
            <MeasureStepper Label="@Loc["Form.Bottom"]" @bind-Value="_m.PanchaWidth" />

            <div class="app-card p-3">
                <p class="truncate text-sm font-medium text-subtle">@Loc["Form.ShalwarStyle"]</p>
                <div class="relative mt-2">
                    <InputSelect @bind-Value="_m.ShalwarStyle" class="app-select">
                        @foreach (var style in Styles)
                        {
                            <option value="@style">@Loc[$"Style.{style}"]</option>
                        }
                    </InputSelect>
                    <span class="pointer-events-none absolute inset-y-0 end-3 flex items-center text-subtle">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                    </span>
                </div>
            </div>
        </div>

        <!-- ===== Design ===== -->
        <SectionHeading Title="@($"{Loc["Form.Design"]} · {Loc["Form.Optional"]}")" />

        <p class="mt-3 text-sm font-medium text-ink">@Loc["Design.Collar"]</p>
        <div class="mt-2 grid grid-cols-3 gap-3">
            <ChoiceCard Label="@Loc["Design.Ban"]" Selected="@(_m.Design.CollarDesign == CollarDesign.Ban)" OnClick="() => SetCollar(CollarDesign.Ban)">
                <Icon><svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4v5a6 6 0 0 0 12 0V4" /></svg></Icon>
            </ChoiceCard>
            <ChoiceCard Label="@Loc["Design.Shirt"]" Selected="@(_m.Design.CollarDesign == CollarDesign.Shirt)" OnClick="() => SetCollar(CollarDesign.Shirt)">
                <Icon><svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 5v4l7 6 7-6V5" /><path d="M5 5 12 9l7-4" /></svg></Icon>
            </ChoiceCard>
            <ChoiceCard Label="@Loc["Design.Sherwani"]" Selected="@(_m.Design.CollarDesign == CollarDesign.Sherwani)" OnClick="() => SetCollar(CollarDesign.Sherwani)">
                <Icon><svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4v5a6 6 0 0 0 12 0V4" /><path d="M12 4v10" /></svg></Icon>
            </ChoiceCard>
        </div>

        <p class="mt-4 text-sm font-medium text-ink">@Loc["Design.Cuff"]</p>
        <div class="mt-2 grid grid-cols-3 gap-3">
            <ChoiceCard Label="@Loc["Design.CuffPlain"]" Selected="@(_m.Design.CuffDesign == CuffDesign.Plain)" OnClick="() => SetCuff(CuffDesign.Plain)">
                <Icon><svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="5" width="14" height="14" rx="2.5" /></svg></Icon>
            </ChoiceCard>
            <ChoiceCard Label="@Loc["Design.CuffOne"]" Selected="@(_m.Design.CuffDesign == CuffDesign.OneButton)" OnClick="() => SetCuff(CuffDesign.OneButton)">
                <Icon><svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="5" width="14" height="14" rx="2.5" /><circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none" /></svg></Icon>
            </ChoiceCard>
            <ChoiceCard Label="@Loc["Design.CuffTwo"]" Selected="@(_m.Design.CuffDesign == CuffDesign.TwoButton)" OnClick="() => SetCuff(CuffDesign.TwoButton)">
                <Icon><svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="5" width="14" height="14" rx="2.5" /><circle cx="9.5" cy="12" r="1.4" fill="currentColor" stroke="none" /><circle cx="14.5" cy="12" r="1.4" fill="currentColor" stroke="none" /></svg></Icon>
            </ChoiceCard>
        </div>

        <p class="mt-4 text-sm font-medium text-ink">@Loc["Design.Pocket"]</p>
        <div class="mt-2 grid grid-cols-3 gap-3">
            <ChoiceCard Label="@Loc["Design.PocketPatch"]" Selected="@(_m.Design.PocketDesign == PocketDesign.Patch)" OnClick="() => SetPocket(PocketDesign.Patch)">
                <Icon><svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M6 5h12v9l-6 5-6-5z" /></svg></Icon>
            </ChoiceCard>
            <ChoiceCard Label="@Loc["Design.PocketFlap"]" Selected="@(_m.Design.PocketDesign == PocketDesign.Flap)" OnClick="() => SetPocket(PocketDesign.Flap)">
                <Icon><svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><rect x="6" y="8" width="12" height="11" rx="1.5" /><path d="M5 8l7-3 7 3" /></svg></Icon>
            </ChoiceCard>
            <ChoiceCard Label="@Loc["Design.PocketVCut"]" Selected="@(_m.Design.PocketDesign == PocketDesign.VCut)" OnClick="() => SetPocket(PocketDesign.VCut)">
                <Icon><svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M6 5h12v7l-6 7-6-7z" /></svg></Icon>
            </ChoiceCard>
        </div>

        @if (_error is not null)
        {
            <p class="mt-5 text-sm text-brick">@_error</p>
        }

        <!-- Spacer so content clears the fixed save bar -->
        <div class="h-28"></div>
    }

    <!-- Fixed save bar -->
    @if (!_loading && !_notFound)
    {
        <div class="fixed inset-x-0 bottom-0 z-30 mx-auto max-w-md bg-cream/95 px-5 pb-[calc(1rem+env(safe-area-inset-bottom))] pt-3 backdrop-blur">
            <button type="submit" disabled="@_saving"
                    class="flex w-full items-center justify-center gap-2 rounded-full bg-brick py-3.5 font-medium text-white shadow-card disabled:opacity-60">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4.5 4.5L19 6" /></svg>
                @Loc["Form.SaveCustomer"]
            </button>
        </div>
    }
</EditForm>

@code {
    [Parameter] public string? Id { get; set; }

    private static readonly ShalwarStyle[] Styles =
    {
        ShalwarStyle.Simple, ShalwarStyle.Pleated, ShalwarStyle.Bootcut,
        ShalwarStyle.Patiala, ShalwarStyle.Aladdin
    };

    private readonly CustomerInput _customer = new();
    private readonly MeasurementSetInput _m = new();
    private string? _editMeasurementSetId;
    private bool _isEdit;
    private bool _loading;
    private bool _saving;
    private bool _notFound;
    private bool _initialized;
    private string? _error;

    protected override void OnInitialized()
        => Loc.LanguageChanged += OnLanguageChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized)
            return;
        _initialized = true;

        _isEdit = !string.IsNullOrEmpty(Id);
        if (!_isEdit)
        {
            ApplyMeasurementDefaults();
            return;
        }

        _loading = true;
        var existing = await CustomerService.GetByIdAsync(Id!);
        if (existing is null)
        {
            _notFound = true;
            _loading = false;
            return;
        }

        _customer.Name = existing.Name;
        _customer.PhoneNumber = existing.PhoneNumber;
        _customer.Address = existing.Address;
        _customer.Notes = existing.Notes;

        var latest = (await MeasurementService.GetHistoryAsync(Id!)).FirstOrDefault();
        if (latest is null)
        {
            ApplyMeasurementDefaults();
        }
        else
        {
            LoadMeasurements(latest);
        }

        _loading = false;
    }

    private void ApplyMeasurementDefaults()
    {
        _m.KameezLength = 42; _m.Chest = 40; _m.Waist = 38;
        _m.Shoulder = 18; _m.SleeveLength = 24; _m.Collar = 16;
        _m.FrontPocket = true; _m.SidePocket = false;
        _m.ShalwarLength = 40; _m.ShalwarWaist = 36; _m.Hip = 44; _m.ThighWidth = 28; _m.PanchaWidth = 14;
        _m.ShalwarStyle = Settings.DefaultShalwarStyle;
    }

    private void LoadMeasurements(MeasurementSetWithDesign source)
    {
        _editMeasurementSetId = source.Measurements.Id;
        var s = source.Measurements;

        _m.Label = s.Label;
        _m.KameezLength = s.KameezLength; _m.Chest = s.Chest; _m.Waist = s.Waist;
        _m.Shoulder = s.Shoulder; _m.SleeveLength = s.SleeveLength; _m.Collar = s.Collar;
        _m.FrontPocket = s.FrontPocket; _m.SidePocket = s.SidePocket;
        _m.ShalwarLength = s.ShalwarLength; _m.ShalwarWaist = s.ShalwarWaist; _m.Hip = s.Hip;
        _m.ThighWidth = s.ThighWidth; _m.PanchaWidth = s.PanchaWidth; _m.ShalwarStyle = s.ShalwarStyle;

        if (source.Design is { } d)
        {
            _m.Design.CollarDesign = d.CollarDesign;
            _m.Design.CuffDesign = d.CuffDesign;
            _m.Design.PocketDesign = d.PocketDesign;
            _m.Design.ButtonStyle = d.ButtonStyle;
        }
    }

    private void SetCollar(CollarDesign value)
        => _m.Design.CollarDesign = _m.Design.CollarDesign == value ? CollarDesign.Unspecified : value;

    private void SetCuff(CuffDesign value)
        => _m.Design.CuffDesign = _m.Design.CuffDesign == value ? CuffDesign.Unspecified : value;

    private void SetPocket(PocketDesign value)
        => _m.Design.PocketDesign = _m.Design.PocketDesign == value ? PocketDesign.Unspecified : value;

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            if (_isEdit)
            {
                await CustomerService.UpdateAsync(Id!, _customer);
                if (_editMeasurementSetId is not null)
                    await MeasurementService.UpdateAsync(_editMeasurementSetId, _m);
                else
                    await MeasurementService.AddAsync(Id!, _m);

                Nav.NavigateTo($"/customers/{Id}");
            }
            else
            {
                var created = await CustomerService.AddAsync(_customer);
                await MeasurementService.AddAsync(created.Id, _m);
                Nav.NavigateTo("/customers");
            }
        }
        catch (ValidationFailedException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void GoBack()
        => Nav.NavigateTo(_isEdit ? $"/customers/{Id}" : "/customers");

    private void OnLanguageChanged(object? sender, EventArgs e)
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Loc.LanguageChanged -= OnLanguageChanged;
}
