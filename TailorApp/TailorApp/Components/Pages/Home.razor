@page "/"
@implements IDisposable
@inject ICustomerService CustomerService
@inject IMeasurementService MeasurementService
@inject ILocalizationService Loc
@inject IAppSettingsService Settings
@inject NavigationManager Nav

<!-- Header -->
<header class="flex items-center justify-between pt-2">
    <div class="flex items-center gap-3">
        <div class="flex h-11 w-11 items-center justify-center rounded-tile bg-brick text-white">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <circle cx="6" cy="6" r="2.6" /><circle cx="6" cy="18" r="2.6" />
                <path d="M8.2 7.6 20 18" /><path d="M8.2 16.4 20 6" />
            </svg>
        </div>
        <div class="leading-tight">
            <h1 class="font-serif text-2xl font-bold text-ink">@Settings.ShopName</h1>
            <p class="text-[10px] font-medium uppercase tracking-[0.2em] text-subtle">@Settings.ShopTagline</p>
        </div>
    </div>

    <button type="button" @onclick='() => Nav.NavigateTo("/settings")'
            class="flex h-10 w-10 items-center justify-center rounded-full text-ink">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 7h10" /><path d="M18 7h2" /><circle cx="16" cy="7" r="2" />
            <path d="M4 17h2" /><path d="M10 17h10" /><circle cx="8" cy="17" r="2" />
        </svg>
    </button>
</header>

<!-- Search -->
<button type="button" @onclick='() => Nav.NavigateTo("/customers")'
        class="mt-4 flex w-full items-center gap-3 rounded-full bg-cream-card px-5 py-3.5 text-start shadow-card">
    <svg class="h-5 w-5 text-subtle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
         stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="7" /><path d="m20 20-3.2-3.2" />
    </svg>
    <span class="text-subtle">@Loc["Home.SearchPlaceholder"]</span>
</button>

<!-- Quick actions -->
<section class="mt-7">
    <div class="flex items-center">
        <h2 class="font-serif text-lg font-bold text-ink">@Loc["Home.QuickActions"]</h2>
        <RulerDivider />
    </div>

    <div class="mt-3 grid grid-cols-3 gap-3">
        <button type="button" @onclick='() => Nav.NavigateTo("/customers/new")'
                class="flex flex-col items-center gap-2 rounded-card bg-brick p-4 text-white shadow-card">
            <span class="icon-tile bg-white/15">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
            </span>
            <span class="text-center text-sm font-medium leading-tight">@Loc["Home.AddCustomer"]</span>
        </button>

        <button type="button" @onclick='() => Nav.NavigateTo("/customers")'
                class="flex flex-col items-center gap-2 app-card p-4">
            <span class="icon-tile bg-cream-line text-ink">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="8" r="3.2" /><path d="M3.5 19a5.5 5.5 0 0 1 11 0" />
                    <path d="M16 5.2a3 3 0 0 1 0 5.6" /><path d="M17.5 19a5.5 5.5 0 0 0-2.5-4.6" />
                </svg>
            </span>
            <span class="text-center text-sm font-medium leading-tight text-ink">@Loc["Home.ViewCustomers"]</span>
        </button>

        <button type="button" @onclick='() => Nav.NavigateTo("/customers")'
                class="flex flex-col items-center gap-2 app-card p-4">
            <span class="icon-tile bg-cream-line text-ink">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3.5" y="4.5" width="17" height="16" rx="2.5" /><path d="M3.5 9h17" />
                    <path d="M8 3v3" /><path d="M16 3v3" />
                </svg>
            </span>
            <span class="text-center text-sm font-medium leading-tight text-ink">@Loc["Home.Recent"]</span>
        </button>
    </div>
</section>

<!-- Overview -->
<section class="mt-7">
    <div class="flex items-center">
        <h2 class="font-serif text-lg font-bold text-ink">@Loc["Home.Overview"]</h2>
        <RulerDivider />
    </div>

    <div class="mt-3 grid grid-cols-2 gap-3">
        <div class="app-card p-4">
            <svg class="h-5 w-5 text-subtle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="8" r="3.2" /><path d="M3.5 19a5.5 5.5 0 0 1 11 0" />
                <path d="M16 5.2a3 3 0 0 1 0 5.6" /><path d="M17.5 19a5.5 5.5 0 0 0-2.5-4.6" />
            </svg>
            <p class="mt-3 font-serif text-4xl font-bold text-ink">@_totalCustomers</p>
            <p class="mt-1 text-sm text-subtle">@Loc["Home.TotalCustomers"]</p>
        </div>

        <div class="app-card p-4">
            <svg class="h-5 w-5 text-brick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="3.5" width="16" height="17" rx="2.5" /><path d="M8 8h8" /><path d="M8 12h8" /><path d="M8 16h5" />
            </svg>
            <p class="mt-3 font-serif text-4xl font-bold text-ink">@_recentOrders</p>
            <p class="mt-1 text-sm text-subtle">@Loc["Home.RecentOrders"]</p>
        </div>
    </div>
</section>

<!-- Recent customers -->
<section class="mt-7">
    <div class="flex items-center justify-between">
        <h2 class="font-serif text-lg font-bold text-ink">@Loc["Home.RecentCustomers"]</h2>
        <a href="/customers" class="text-sm font-medium text-brick">@Loc["Home.ViewAll"]</a>
    </div>

    <div class="mt-3">
        @if (_loading)
        {
            <div class="app-card border-s-4 border-brick px-4 py-6 text-center text-sm text-subtle">@Loc["Common.Loading"]</div>
        }
        else if (_recent.Count == 0)
        {
            <div class="app-card border-s-4 border-brick px-4 py-6 text-center text-sm text-subtle">@Loc["History.Empty"]</div>
        }
        else
        {
            <div class="app-card overflow-hidden border-s-4 border-brick">
                @foreach (var customer in _recent)
                {
                    <a href="@($"/customers/{customer.Id}")"
                       class="flex items-center gap-3 border-b border-cream-line px-4 py-3 last:border-0">
                        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-blush text-sm font-semibold text-brick">
                            @DisplayFormat.Initials(customer.Name)
                        </span>
                        <div class="min-w-0 flex-1">
                            <p class="truncate font-semibold text-ink">@customer.Name</p>
                            @if (!string.IsNullOrWhiteSpace(customer.PhoneNumber))
                            {
                                <p class="mt-0.5 flex items-center gap-1.5 text-sm text-subtle">
                                    <svg class="h-3.5 w-3.5 shrink-0 text-brick" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.2 2.2Z" />
                                    </svg>
                                    <span class="truncate">@customer.PhoneNumber</span>
                                </p>
                            }
                        </div>
                        <div class="flex shrink-0 flex-col items-end gap-1">
                            <span class="text-xs text-subtle">@DisplayFormat.RelativeTime(customer.CreatedAt)</span>
                            <svg class="h-4 w-4 text-subtle rtl:rotate-180" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m9 6 6 6-6 6" />
                            </svg>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</section>

@code {
    private int _totalCustomers;
    private int _recentOrders;
    private IReadOnlyList<Customer> _recent = Array.Empty<Customer>();
    private bool _loading = true;

    protected override void OnInitialized()
    {
        Loc.LanguageChanged += OnLanguageChanged;
        Settings.Changed += OnLanguageChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        _totalCustomers = await CustomerService.CountAsync();
        _recentOrders = await MeasurementService.CountRecentAsync(30);
        _recent = await CustomerService.GetRecentAsync(5);
        _loading = false;
    }

    private void OnLanguageChanged(object? sender, EventArgs e)
        => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Loc.LanguageChanged -= OnLanguageChanged;
        Settings.Changed -= OnLanguageChanged;
    }
}
