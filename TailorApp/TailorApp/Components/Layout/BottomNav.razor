@implements IDisposable
@inject NavigationManager Nav
@inject ILocalizationService Loc

@if (!Hidden)
{
<nav class="fixed inset-x-0 bottom-0 z-30 mx-auto flex w-full max-w-md items-stretch justify-around
            border-t border-cream-border bg-cream/95 px-2 pb-[calc(0.5rem+env(safe-area-inset-bottom))] pt-2
            shadow-nav backdrop-blur">

    <a href="/" class="@ItemClass("")">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 10.5 12 3l9 7.5" />
            <path d="M5 9.5V20a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9.5" />
        </svg>
        <span>@Loc["Nav.Home"]</span>
    </a>

    <a href="/customers" class="@ItemClass("customers")">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="8" r="3.2" />
            <path d="M3.5 19a5.5 5.5 0 0 1 11 0" />
            <path d="M16 5.2a3 3 0 0 1 0 5.6" />
            <path d="M17.5 19a5.5 5.5 0 0 0-2.5-4.6" />
        </svg>
        <span>@Loc["Nav.Customers"]</span>
    </a>

    <a href="/orders" class="@ItemClass("orders")">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 8h12l-.8 11a1 1 0 0 1-1 .9H7.8a1 1 0 0 1-1-.9z" />
            <path d="M9 8V7a3 3 0 0 1 6 0v1" />
        </svg>
        <span>@Loc["Nav.Orders"]</span>
    </a>

    <a href="/settings" class="@ItemClass("settings")">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 7h10" /><path d="M18 7h2" /><circle cx="16" cy="7" r="2" />
            <path d="M4 17h2" /><path d="M10 17h10" /><circle cx="8" cy="17" r="2" />
        </svg>
        <span>@Loc["Nav.Settings"]</span>
    </a>
</nav>
}

@code {
    protected override void OnInitialized()
        => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    private string Relative =>
        Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');

    // Full-screen create/edit flows replace the nav with their own action bar.
    private bool Hidden =>
        Relative.EndsWith("/new", StringComparison.Ordinal) ||
        Relative.EndsWith("/edit", StringComparison.Ordinal);

    private bool IsActive(string route)
        => route.Length == 0
            ? Relative.Length == 0
            : Relative == route || Relative.StartsWith(route + "/", StringComparison.Ordinal);

    private string ItemClass(string route)
    {
        var state = IsActive(route) ? "text-brick" : "text-subtle";
        return $"flex flex-1 flex-col items-center gap-1 py-1 text-[11px] font-medium {state}";
    }

    public void Dispose()
        => Nav.LocationChanged -= OnLocationChanged;
}
