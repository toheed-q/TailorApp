@inherits LayoutComponentBase
@implements IDisposable
@inject ILocalizationService Loc
@inject IAppSettingsService Settings
@inject IJSRuntime JS

<div dir="@Loc.Direction"
     class="relative mx-auto flex min-h-[100dvh] w-full max-w-md flex-col bg-cream">
    <main class="flex-1 px-5 pb-28 pt-[calc(0.75rem+env(safe-area-inset-top))]">
        @Body
    </main>

    <BottomNav />
</div>

@if (_showWelcome)
{
    <div class="fixed inset-0 z-[100] mx-auto flex max-w-md flex-col items-center justify-center bg-cream px-8 text-center transition-opacity duration-500 @(_welcomeFadingOut ? "opacity-0" : "opacity-100")">
        <img src="img/logo.png" alt="Shani Tailor" class="w-52 max-w-[68%]" />
        <h1 class="mt-8 font-serif text-3xl font-bold text-ink">Welcome, Zeeshan</h1>
        <p class="mt-1 text-sm text-subtle">Let's get stitching</p>
        <p class="absolute bottom-10 text-[11px] font-semibold uppercase tracking-[0.25em] text-subtle">Shani Tailor</p>
    </div>
}

@code {
    // Shown once per app launch (the layout instance persists across navigations).
    private static bool _welcomeSeen;
    private bool _showWelcome = !_welcomeSeen;
    private bool _welcomeFadingOut;

    protected override void OnInitialized()
    {
        Loc.LanguageChanged += OnSettingsChanged;
        Settings.Changed += OnSettingsChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await ApplyTextSizeAsync();

        if (_showWelcome)
        {
            _welcomeSeen = true;
            await Task.Delay(2200);
            _welcomeFadingOut = true;
            StateHasChanged();
            await Task.Delay(500);
            _showWelcome = false;
            StateHasChanged();
        }
    }

    private async Task ApplyTextSizeAsync()
    {
        var percent = Settings.TextSize switch
        {
            TextSize.Small => 90,
            TextSize.Large => 115,
            _ => 100
        };
        try
        {
            await JS.InvokeVoidAsync("tailorApp.setFontScale", percent);
        }
        catch (JSException)
        {
            // Non-fatal: the app is fully usable at the default size.
        }
    }

    private void OnSettingsChanged(object? sender, EventArgs e)
        => InvokeAsync(async () =>
        {
            StateHasChanged();
            await ApplyTextSizeAsync();
        });

    public void Dispose()
    {
        Loc.LanguageChanged -= OnSettingsChanged;
        Settings.Changed -= OnSettingsChanged;
    }
}
